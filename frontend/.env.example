# Reference only: Vite does not automatically load a file named .env.example.
# For local overrides, copy needed entries into your existing frontend/.env.local.
# Do not overwrite existing Supabase settings accidentally.

VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
VITE_ENVIRONMENT=development

# Public client values only; never put the Supabase service-role/secret key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
